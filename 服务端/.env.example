# =============================================================================
# 销售 CRM · 服务端环境变量模板
# ★ 本文件入 git（供他人照抄）；真实值放同目录 .env（已被根 .gitignore 忽略）
# ★ 键名口径来源：《过程产出/开发计划-V1.md》M0-06
# =============================================================================

# --- MySQL（Prisma 消费；prisma/schema.prisma 中 url = env("DATABASE_URL")）---
# 格式：mysql://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/win_crm"

# --- Redis（登录态 / 字典 / 管辖部门集合 / 规则缓存）---
REDIS_URL="redis://127.0.0.1:6379"

# --- JWT 签名密钥（V1 鉴权＝账号密码 + JWT）---
# ★ 生产环境必须替换为长随机串，禁止沿用开发值
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# --- Web 进程监听端口（Worker 进程不监听端口）---
PORT=3000
